{
  "name": "@im/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=4096 next typegen && NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/unit/*.test.mjs",
    "test:db": "node tests/_lib/global-setup.mjs && node --test tests/*.test.mjs",
    "test:purge": "node tests/purge-e2e-data.mjs",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report e2e/.report",
    "cms": "PAYLOAD_CONFIG_PATH=src/cms/payload.config.ts payload",
    "cms:generate": "PAYLOAD_CONFIG_PATH=src/cms/payload.config.ts payload generate:importmap && PAYLOAD_CONFIG_PATH=src/cms/payload.config.ts payload generate:types",
    "cms:migrate": "PAYLOAD_CONFIG_PATH=src/cms/payload.config.ts payload migrate",
    "cms:migrate:create": "PAYLOAD_CONFIG_PATH=src/cms/payload.config.ts payload migrate:create",
    "cms:seed": "PAYLOAD_CONFIG_PATH=src/cms/payload.config.ts payload run src/cms/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.157",
    "@im/core": "workspace:*",
    "@im/db": "workspace:*",
    "@im/tokens": "workspace:*",
    "@im/ui": "workspace:*",
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/storage-s3": "3.92.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "^7.0.153",
    "clsx": "^2.1.1",
    "graphql": "^16.14.2",
    "lucide-react": "latest",
    "next": "16.4.3",
    "payload": "3.92.1",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "zod": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.28.0"
}
