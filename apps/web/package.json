{
  "name": "@im/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3102",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=4096 next typegen && NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit",
    "test:db": "node tests/_lib/global-setup.mjs && node --test tests/*.test.mjs",
    "test:purge": "node tests/purge-e2e-data.mjs",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report e2e/.report",
    "test": "node --experimental-test-module-mocks --import ./tests/unit/register.mjs --test tests/unit/*.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.157",
    "@im/core": "workspace:*",
    "@im/db": "workspace:*",
    "@im/tokens": "workspace:*",
    "@im/ui": "workspace:*",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "^7.0.153",
    "clsx": "^2.1.1",
    "lucide-react": "latest",
    "next": "16.4.3",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "zod": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.28.0"
}
