{
  "expo": {
    "name": "Covva",
    "slug": "covva",
    "scheme": "covva",
    "version": "0.1.0",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.covva.app",
      "supportsTablet": true,
      "infoPlist": {
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "package": "com.covva.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/with-adaptive-orientation"
    ],
    "orientation": "default",
    "extra": {
      "eas": {
        "projectId": "b4854e6b-d2a5-42cc-9c17-319f98876c94"
      }
    },
    "owner": "nella-interactive"
  }
}
