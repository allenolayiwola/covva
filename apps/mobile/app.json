{
  "expo": {
    "name": "Covva",
    "slug": "covva",
    "scheme": "covva",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.covva.app",
      "supportsTablet": true,
      "infoPlist": {
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:insurance-marketplace-tau.vercel.app",
        "applinks:app.covva.com.gh",
        "webcredentials:insurance-marketplace-tau.vercel.app",
        "webcredentials:app.covva.com.gh"
      ]
    },
    "android": {
      "package": "com.covva.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "insurance-marketplace-tau.vercel.app",
              "pathPrefix": "/account"
            },
            {
              "scheme": "https",
              "host": "insurance-marketplace-tau.vercel.app",
              "pathPrefix": "/auth/callback"
            },
            {
              "scheme": "https",
              "host": "app.covva.com.gh",
              "pathPrefix": "/account"
            },
            {
              "scheme": "https",
              "host": "app.covva.com.gh",
              "pathPrefix": "/auth/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "./plugins/with-adaptive-orientation"
    ],
    "orientation": "default",
    "extra": {
      "eas": {
        "projectId": "b4854e6b-d2a5-42cc-9c17-319f98876c94"
      }
    },
    "owner": "nella-interactive"
  }
}
