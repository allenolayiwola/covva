# ---------------------------------------------------------------------------
# Covva — environment variables
# Copy to apps/web/.env.local and apps/admin/.env.local for local development.
# On Vercel, set these per project (web, admin). Never commit real secrets.
# ---------------------------------------------------------------------------

# Supabase (project: insurance-marketplace, ref krmnyqaweawkpygjmdry, eu-west-2)
NEXT_PUBLIC_SUPABASE_URL=https://krmnyqaweawkpygjmdry.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_31vynddS7Uu45RJAYp0MUQ_OaBkDx22
# Server-only. Supabase dashboard → Project Settings → API keys → secret key.
SUPABASE_SECRET_KEY=

# Public URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000        # production: https://covva.com.gh
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001       # production: https://admin.covva.com.gh

# Vercel AI Gateway (Vercel dashboard → AI Gateway → API keys). On Vercel, OIDC is used automatically.
AI_GATEWAY_API_KEY=
AI_DEFAULT_MODEL=anthropic/claude-sonnet-5.5
AI_FAST_MODEL=anthropic/claude-haiku-5.5

# Paystack (premiums settle to insurer subaccounts — never to the platform)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Optional Paystack split group (SPL_…) for three-way checkout splits (insurer / broker / Covva fee).
# Without it (or an org-level organizations.paystack_split_code) checkout settles to the insurer's single
# subaccount and commission / fees are settled by the monthly settlement statement.
PAYSTACK_SPLIT_GROUP_CODE=

# Bank transfer channel. PAYSTACK_DVA_ENABLED=true creates a Paystack dedicated virtual account per customer
# (auto-confirmed by charge.success). Otherwise transfers go to the INSURER's bank account from
# organizations.settings.bank_account {bank, account_name, account_number} and are confirmed at reconciliation.
# platform_settings.payments.bank_transfer {reference_prefix} only sets the reference prefix.
PAYSTACK_DVA_ENABLED=false
PAYSTACK_DVA_BANK=            # optional preferred_bank slug for dedicated accounts

# Payment provider switch: paystack (default) | hubtel. Per insurer: organizations.settings.payment_provider.
PAYMENT_PROVIDER=paystack
# Hubtel Online Checkout (second provider). The merchant account must be the insurer's
# (organizations.settings.hubtel_merchant_account) so premiums never touch Covva.
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=
HUBTEL_WEBHOOK_SECRET=        # callbacks are unsigned: this secret is required on /api/webhooks/hubtel

# Vehicle lookup (motor quote prefill). VEHICLE_LOOKUP_PROVIDER = cache (default) | dvla | manual.
# DVLA / partner API stub: unset → the form asks for make, model and year.
VEHICLE_LOOKUP_PROVIDER=cache
DVLA_API_URL=
DVLA_API_KEY=

# Ghana Card verification. IDENTITY_PROVIDER = manual (default: admin review) | nia.
IDENTITY_PROVIDER=manual
NIA_API_URL=
NIA_API_KEY=

# WhatsApp Business channel (notifications, conversations, AI FAQ bot, broker one-tap accept).
# WHATSAPP_PROVIDER = log (default: messages are only logged) | meta (WhatsApp Cloud API).
# Set the same WHATSAPP_* values on the admin project: the support console sends replies too.
WHATSAPP_PROVIDER=log
WHATSAPP_BUSINESS_ID=         # WhatsApp Business Account id (Meta Business Manager)
WHATSAPP_PHONE_NUMBER_ID=     # the business phone number id the Cloud API sends from
WHATSAPP_ACCESS_TOKEN=        # permanent system-user token with whatsapp_business_messaging
WHATSAPP_APP_SECRET=          # Meta app secret: verifies X-Hub-Signature-256 on /api/webhooks/whatsapp
WHATSAPP_VERIFY_TOKEN=        # any random string; paste the same value in the webhook subscription (hub.verify_token)
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=en
# Phase 1 generic templates (title / body / link) used when a notification kind has no registered template.
WHATSAPP_TEMPLATE_RENEWAL=covva_renewal_reminder
WHATSAPP_TEMPLATE_GENERIC=covva_update

# Messaging
RESEND_API_KEY=
EMAIL_FROM="Covva <no-reply@covva.com.gh>"
SMS_PROVIDER=log            # log | arkesel | hubtel
SMS_API_KEY=
SMS_SENDER_ID=COVVA

# Expo push (mobile)
EXPO_ACCESS_TOKEN=

# NIC motor insurance database registration for delegated (Level 2) motor policies:
#   manual (default) = hand-off task for the insurer, tracked on issuance_jobs.nic_registration
#   api              = through the insurer's connector adapter (simulator only for now; falls back to manual)
NIC_MOTOR_DB_MODE=manual

# Vercel Cron shared secret
CRON_SECRET=

# ---------------------------------------------------------------------------
# Marketing site conversion features (Addendum 5). All optional; features hide when unset.
# ---------------------------------------------------------------------------
# WhatsApp chat button on every marketing page. International format, digits only (e.g. 233501234567).
NEXT_PUBLIC_WHATSAPP_NUMBER=
# iOS smart app banner (<meta name="apple-itunes-app">): the numeric App Store id.
NEXT_PUBLIC_IOS_APP_ID=
# Android app banner: the Play Store package name (e.g. gh.com.covva.app). Shown on Android browsers only.
NEXT_PUBLIC_ANDROID_PACKAGE=
# Store links for the App Store / Google Play badges. Badges read "Coming at launch" until these are set.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
# Google Analytics 4 measurement id (G-XXXXXXX). Loaded only after the visitor accepts analytics in the Act 843 consent banner.
NEXT_PUBLIC_GA4_ID=

# ---------------------------------------------------------------------------
# Diaspora (sponsor ↔ beneficiary consent). Signs the no-login consent links sent to beneficiaries
# by SMS/WhatsApp (/consent/<token>, HMAC-SHA256 over beneficiary id + consent kind + expiry).
# Falls back to SUPABASE_SECRET_KEY when unset; set a dedicated value in production.
# ---------------------------------------------------------------------------
CONSENT_LINK_SECRET=

# ---------------------------------------------------------------------------
# Diaspora payments: pay in GBP/USD/EUR/CAD (indicative display), settle in GHS to the insurer,
# recurring sponsor collections. See docs/OPERATIONS.md → Diaspora payments.
# ---------------------------------------------------------------------------
# Card PSP for foreign-currency payers: paystack_intl (default; Paystack international cards are charged the
# GHS amount and settle to the insurer's subaccount) | stripe (OFF until the legal view: Stripe settles foreign
# currency to Covva before the insurer is paid — collection-on-behalf; needs STRIPE_SETTLEMENT_APPROVED=true).
DIASPORA_PSP=paystack_intl
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SETTLEMENT_APPROVED=false
# Apple Pay / Google Pay on Paystack's hosted checkout (enable the channel on the Paystack business first).
PAYSTACK_APPLE_PAY=false
# Let Paystack drive sponsor subscriptions (plan + subscription per sponsor) instead of Covva's daily
# sponsor-collections cron charging the stored authorisation. Default off (Covva-driven, retries 1d/3d/7d).
PAYSTACK_MANAGED_SUBSCRIPTIONS=false
# FX display rates: FX_PROVIDER = manual (default: admin overrides only) | openexchangerates | bog (stub).
# Overrides platform_settings.fx.provider. The hourly `fx-rates` cron appends rows to fx_rates.
FX_PROVIDER=manual
OPENEXCHANGERATES_APP_ID=
